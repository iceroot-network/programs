{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iceroot-network/programs/schemas/binding.schema.json",
  "title": "binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example",
    "id",
    "github_user_id",
    "previous",
    "posted_at",
    "effective_at",
    "post_url",
    "post_author_id",
    "testnet_address",
    "message",
    "public_key",
    "signature",
    "status",
    "verification",
    "mainnet",
    "signed_at",
    "revoked_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "example": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^LINK-[0-9]+-[0-9]{4,}(?![\\s\\S])"
    },
    "github_user_id": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^LINK-[0-9]+-[0-9]{4,}(?![\\s\\S])"
        }
      ]
    },
    "posted_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "post_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^https://[^\\s]+(?![\\s\\S])"
    },
    "post_author_id": {
      "type": "integer",
      "minimum": 1
    },
    "testnet_address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(tice1[023456789acdefghjklmnpqrstuvwxyz]{58}|example-[a-z0-9-]+)(?![\\s\\S])"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "public_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "enum": [
        "pending",
        "verified",
        "revoked"
      ]
    },
    "verification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence",
            "at"
          ],
          "properties": {
            "evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^https://[^\\s]+(?![\\s\\S])"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "mainnet": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "transaction_id",
            "at",
            "memo",
            "evidence"
          ],
          "properties": {
            "address": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^(ice1[023456789acdefghjklmnpqrstuvwxyz]{58}|example-[a-z0-9-]+)(?![\\s\\S])"
            },
            "transaction_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "memo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^https://[^\\s]+(?![\\s\\S])"
            }
          }
        }
      ]
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    }
  }
}
