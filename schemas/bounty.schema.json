{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iceroot-network/programs/schemas/bounty.schema.json",
  "title": "bounty",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example",
    "id",
    "entry",
    "source",
    "github_user_id",
    "kind",
    "rating",
    "amount",
    "status",
    "claim_url",
    "rating_evidence",
    "related_party",
    "relationship",
    "duplicate_of",
    "advisory",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "example": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[A-Z]{3,6}-[0-9]{4,}(?![\\s\\S])"
    },
    "entry": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[A-Z]{3,6}-[0-9]{4,}(?![\\s\\S])"
        }
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^https://[^\\s]+(?![\\s\\S])"
    },
    "github_user_id": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "security",
        "bug",
        "contribution"
      ]
    },
    "rating": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "bug",
        "tier-1",
        "tier-2",
        "tier-3",
        "posted",
        "credit",
        "none"
      ]
    },
    "amount": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(0|[1-9][0-9]{0,39})(?![\\s\\S])"
    },
    "status": {
      "enum": [
        "review",
        "accepted",
        "duplicate",
        "rejected",
        "paid",
        "credited"
      ]
    },
    "claim_url": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^https://[^\\s]+(?![\\s\\S])"
        }
      ]
    },
    "rating_evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^https://[^\\s]+(?![\\s\\S])"
    },
    "related_party": {
      "type": "boolean"
    },
    "relationship": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      ]
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^https://[^\\s]+(?![\\s\\S])"
        }
      ]
    },
    "advisory": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "published_at",
            "private_report_confirmed"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^https://[^\\s]+(?![\\s\\S])"
            },
            "published_at": {
              "type": "string",
              "format": "date-time"
            },
            "private_report_confirmed": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
