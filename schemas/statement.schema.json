{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iceroot-network/programs/schemas/statement.schema.json",
  "title": "statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example",
    "id",
    "month",
    "prepared_at",
    "status",
    "approval",
    "transactions",
    "earned_entries",
    "credit_only"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "example": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^MONTH-[0-9]{4}-[0-9]{2}(?![\\s\\S])"
    },
    "month": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(?![\\s\\S])"
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "paid"
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pull_request",
            "at"
          ],
          "properties": {
            "pull_request": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^https://[^\\s]+(?![\\s\\S])"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "pool",
          "payment",
          "fingerprint",
          "memo",
          "amount",
          "related_party"
        ],
        "properties": {
          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[A-Z]{3,6}-[0-9]{4,}(?![\\s\\S])"
          },
          "pool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "payment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pool_address",
              "recipients"
            ],
            "properties": {
              "pool_address": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^(ice1[023456789acdefghjklmnpqrstuvwxyz]{58}|example-[a-z0-9-]+)(?![\\s\\S])"
              },
              "recipients": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "address",
                    "amount"
                  ],
                  "properties": {
                    "address": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "pattern": "^(ice1[023456789acdefghjklmnpqrstuvwxyz]{58}|example-[a-z0-9-]+)(?![\\s\\S])"
                    },
                    "amount": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "pattern": "^[1-9][0-9]{0,39}(?![\\s\\S])"
                    }
                  }
                },
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true
              }
            }
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "memo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "amount": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[1-9][0-9]{0,39}(?![\\s\\S])"
          },
          "related_party": {
            "type": "boolean"
          }
        }
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "earned_entries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "^[A-Z]{3,6}-[0-9]{4,}(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "credit_only": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "^[A-Z]{3,6}-[0-9]{4,}(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    }
  }
}
